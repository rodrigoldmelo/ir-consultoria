# Copiar para .env.local — nunca commitar secrets.
# Prefixo IR_ para não colidir com a Lis / Conversa Hub.

# --- App ---
IR_APP_ENV=development
PORT=3010
IR_PUBLIC_API_URL=http://localhost:3010
IR_INTERNAL_API_URL=http://localhost:3010
IR_AGENT_NAME=IR Assistente
IR_PANEL_OPERATOR_NAME=Inglyd Reis
IR_DEFAULT_TIMEZONE=America/Sao_Paulo
IR_PANEL_TOKEN=change-me-local-only
# Login do painel (cookie HttpOnly, igual à Lis). User padrão: admin.
# Se IR_PANEL_LOGIN_PASSWORD estiver vazio, a senha é IR_PANEL_TOKEN.
IR_PANEL_LOGIN_USER=admin
IR_PANEL_LOGIN_PASSWORD=
IR_PANEL_SESSION_SECRET=change-me-to-at-least-32-characters-long

# --- Supabase (projeto próprio; schema ir_*) ---
IR_SUPABASE_URL=
IR_SUPABASE_ANON_KEY=
IR_SUPABASE_SERVICE_ROLE_KEY=
IR_STORAGE_DOCUMENTS_BUCKET=ir-documents

# --- OpenAI (cérebro do agente WhatsApp) ---
IR_OPENAI_API_KEY=
IR_OPENAI_MODEL=gpt-4o-mini
IR_OPENAI_EXTRACTION_MODEL=gpt-4o-mini
IR_OPENAI_REHEAT_MODEL=gpt-4o

# --- Meta Lead Ads ---
IR_META_APP_ID=
IR_META_APP_SECRET=
IR_META_VERIFY_TOKEN=
IR_META_PAGE_ID=
IR_META_FORM_IDS=
# Page Access Token com leads_retrieval, usado para pull/busca de detalhes leadgen.
IR_META_PAGE_TOKEN=
IR_META_GRAPH_VERSION=v20.0

# --- WhatsApp Cloud API (WABA própria — NÃO usar da V&C) ---
IR_META_WABA_ID=
IR_META_PHONE_NUMBER_ID=
IR_META_WHATSAPP_TOKEN=
IR_WHATSAPP_TEMPLATE_INITIAL=contato_inicial
IR_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Drip (após template inicial; só com 0003 + worker)
IR_WHATSAPP_TEMPLATE_TRUST=
IR_WHATSAPP_TEMPLATE_EXPLAIN=
IR_WHATSAPP_TEMPLATE_REHEAT=
IR_WHATSAPP_TEMPLATE_CNIS_REMINDER=lembrete_envio_cnis_03
IR_WHATSAPP_TEMPLATE_CONTINUE_ANALYSIS=continuar_analise_inss_02
IR_WHATSAPP_TEMPLATE_RESUME_ANALYSIS=retomar_analise_inss_01
IR_DRIP_STEP2_HOURS=24
IR_DRIP_STEP3_HOURS=120
IR_DOCUMENT_REMINDER_HOUR=8
IR_DOCUMENT_REMINDER_MINUTE=30

# --- Advbox ---
IR_ADVBOX_BASE_URL=
IR_ADVBOX_API_TOKEN=
IR_ADVBOX_RESPONSIBLE_USER_ID=
IR_ADVBOX_TASK_TYPE_ID=
IR_ADVBOX_CASE_TYPE_ID=

# --- Workers ---
IR_TEMPLATE_WORKER_ENABLED=true
IR_META_LEAD_PULL_WORKER_ENABLED=false
IR_META_LEAD_PULL_INTERVAL_SECONDS=60
IR_META_LEAD_PULL_LIMIT=10
IR_ADVBOX_SYNC_WORKER_ENABLED=false
IR_DOCUMENT_CLASSIFICATION_WORKER_ENABLED=false
IR_FOLLOW_UP_WORKER_ENABLED=false
IR_INWINDOW_NUDGE_ENABLED=false
IR_DOCUMENT_INWINDOW_NUDGE_HOURS=20
IR_DOCUMENT_INWINDOW_NUDGE_TEXT=
